# ==============================================================================
# personal-antigravity-api - Environment Configuration Template
# Mirroring docs/architecture-contract.md (§6, §14)
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Runtime environment ('development' | 'production' | 'test').
# In 'production', API_KEYS is strictly REQUIRED (fail fast).
# Default: development
NODE_ENV=development

# Network bind host. Render requires 0.0.0.0.
# Default: 0.0.0.0
HOST=0.0.0.0

# HTTP server port. Render automatically injects its own PORT.
# Default: 3000
PORT=3000

# Pino logging level ('trace' | 'debug' | 'info' | 'warn' | 'error' | 'fatal').
# Default: info
LOG_LEVEL=info

# Comma-separated list of valid client API keys for Bearer authentication.
# REQUIRED in production. Unset in dev/test defaults to 'dev-local-key' with a warning.
# Example: personal-secret-key-1,client-app-key-2
API_KEYS=

# In-memory fixed-window rate limit window in milliseconds.
# Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# In-memory fixed-window rate limit maximum requests per window.
# Setting to 0 disables rate limiting completely.
# Default: 60
RATE_LIMIT_MAX=60

# Allowed CORS origins. Use '*' for open access, or a comma-separated list of origins.
# Example: http://localhost:3000,https://chat.example.com
# Default: *
CORS_ORIGINS=*

# Whether to trust X-Forwarded-For headers for client IP resolution.
# Set to 'true' on Render and other reverse proxies.
# Default: false
TRUST_PROXY=false

# Antigravity is the only supported provider and the default.
# Connect an account in /admin before sending chat requests.
PROVIDER_MODE=antigravity

# ==============================================================================
# Antigravity Provider Credentials (used when PROVIDER_MODE=antigravity)
# ==============================================================================

# Short-lived OAuth access token (optional; refresh token is preferred).
ANTIGRAVITY_ACCESS_TOKEN=

# Persistent OAuth refresh token (preferred persistent credential on Render).
ANTIGRAVITY_REFRESH_TOKEN=

# OAuth client ID (optional if using default/embedded client credentials).
ANTIGRAVITY_CLIENT_ID=

# OAuth client secret (optional if using default/embedded client credentials).
ANTIGRAVITY_CLIENT_SECRET=

# Cloud project ID (optional).
ANTIGRAVITY_PROJECT_ID=

# Base URL override for upstream Antigravity provider endpoint.
# Leave blank to use provider default.
ANTIGRAVITY_ENDPOINT=

# File path for opportunistic on-disk token caching.
# NOTE: Render Free disk is EPHEMERAL; files are wiped on sleep/restart.
# Dashboard environment variables remain the persistent source of truth.
# Default: ./.data/antigravity-token.json
ANTIGRAVITY_TOKEN_STORE_PATH=./.data/antigravity-token.json

# ==============================================================================
# Account Management Dashboard (v1.1 - docs/architecture-contract.md §13-§16)
# ==============================================================================

# Dashboard mode: 'auto' | 'true' | 'false'.
# 'auto' enables the dashboard if an admin password or hash is configured.
# Default: auto
DASHBOARD_ENABLED=auto

# Plaintext admin password (dev convenience; never use in public production).
ADMIN_PASSWORD=

# Preferred production admin password hash (format: scrypt$N$r$p$<saltB64>$<hashB64>).
# Generate locally using:
#   node scripts/hash-admin-password.mjs "your password"
ADMIN_PASSWORD_HASH=

# Admin session & cookie lifetime in milliseconds. Sliding expiry on access.
# Default: 43200000 (12 hours)
ADMIN_SESSION_TTL_MS=43200000

# Login attempt rate limit window in milliseconds.
# Default: 300000 (5 minutes)
ADMIN_LOGIN_WINDOW_MS=300000

# Maximum login attempts allowed per IP within the login window.
# Setting to 0 disables login rate limiting.
# Default: 5
ADMIN_LOGIN_MAX=5

# Credential persistence backend: 'auto' | 'file' | 'redis'.
# 'auto' uses redis if REDIS_URL is provided, otherwise falls back to file.
# Default: auto
CREDENTIAL_STORE=auto

# Redis connection URL for durable credential persistence (survives Render restarts).
# Example: rediss://default:password@eu1-key-example.upstash.io:6379
REDIS_URL=

# File path for file-based credential storage (local development only).
# Ephemeral on Render Free instances!
# Default: ./.data/credential-store.json
CREDENTIAL_FILE_PATH=./.data/credential-store.json

# 256-bit encryption key or passphrase for AES-256-GCM credential envelope encryption.
# REQUIRED when the dashboard is enabled (fail-closed).
# Generate a secure 32-byte base64 key using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# Public base URL for the OAuth callback redirect URI (e.g. https://your-service.onrender.com).
# When unset, derived dynamically from the incoming request Host header.
OAUTH_REDIRECT_BASE_URL=

# OAuth scopes for browser-based Antigravity connection (space- or comma-separated).
# Default: openid email https://www.googleapis.com/auth/cloud-platform https://www.googleapis.com/auth/userinfo.email
ANTIGRAVITY_OAUTH_SCOPES=

# Google OAuth authorization endpoint override (test seam).
# Default: https://accounts.google.com/o/oauth2/v2/auth
ANTIGRAVITY_OAUTH_AUTH_ENDPOINT=

# Google OAuth token exchange/refresh endpoint override (test seam).
# Default: https://oauth2.googleapis.com/token
ANTIGRAVITY_OAUTH_TOKEN_ENDPOINT=
